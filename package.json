{
    "name": "ea-seminari7-jwt-websockets-backend",
    "version": "1.0.0",
    "description": "API REST de autores y libros del Seminario 7 de EA: Express, TypeScript y MongoDB, con JWT y WebSockets",
    "main": "src/server.ts",
    "type": "commonjs",
    "engines": {
        "node": ">=22.12"
    },
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node build/server.js",
        "seed": "tsx src/seed.ts",
        "migrate-indexes": "tsx src/migrate-indexes.ts",
        "migrate-authors": "tsx src/migrate-authors.ts",
        "lint": "oxlint src",
        "lint:fix": "oxlint src --fix"
    },
    "author": "",
    "license": "MIT",
    "dependencies": {
        "chalk": "^4.1.2",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "joi": "^18.2.9",
        "joi-to-swagger": "^6.2.0",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^9.10.1",
        "socket.io": "^4.8.4",
        "swagger-jsdoc": "^6.3.0",
        "swagger-ui-express": "^5.0.1"
    },
    "devDependencies": {
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^24.0.0",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.8",
        "oxlint": "^1.85.0",
        "tsx": "^4.23.15",
        "typescript": "~6.0.3"
    }
}
